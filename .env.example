DATABASE_URL="file:./demo.db"

# AI intent extraction: mock | auto | claude | openai | deepseek | gemini | openrouter
# The /settings/ai page can override the mode, order and models below; these
# values apply until it saves. Providers without a key are skipped, and local
# rule-based extraction (mock) is the final fallback.
AI_MODE=mock
AI_PROVIDERS=claude,openai,deepseek,gemini,openrouter
AI_TIMEOUT_MS=15000
# Required to change AI settings or run test calls on a production server.
AI_SETTINGS_TOKEN=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Gemini (Google, OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (one key, many models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Torob Entekhab

# USD per million tokens. Per-provider rates (ANTHROPIC_, OPENAI_, DEEPSEEK_,
# GEMINI_, OPENROUTER_ + INPUT_COST_PER_MILLION / OUTPUT_COST_PER_MILLION)
# override these; 0 means unknown. Claude list prices are built in.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

TOROB_MCP_URL=https://torob-mcp.mmdju3.workers.dev/mcp
PRICE_SOURCE=torob
