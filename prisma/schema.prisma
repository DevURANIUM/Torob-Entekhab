generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model Product {
  id String @id
  slug String @unique
  data Json
}
model Event {
  id Int @id @default(autoincrement())
  name String
  value String?
  createdAt DateTime @default(now())
}
model AiRun {
  id Int @id @default(autoincrement())
  mode String
  fallback Boolean
  latency Float
  inputTokens Int
  outputTokens Int
  estimatedCost Float?
  createdAt DateTime @default(now())
}
model PhoneModel {
 id String @id
 data Json
 variants PhoneVariant[]
}
model PhoneVariant {
 id String @id
 modelId String
 model PhoneModel @relation(fields: [modelId], references: [id])
 data Json
 prices PriceSnapshot[]
}
model PriceSnapshot {
 id String @id
 variantId String
 variant PhoneVariant @relation(fields: [variantId], references: [id])
 amount Int
 observedAt DateTime
 isDemo Boolean
 data Json
 @@index([variantId, observedAt])
}
